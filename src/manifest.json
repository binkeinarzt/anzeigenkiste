{
  "manifest_version": 3,
  "name": "Anzeigenkiste",
  "short_name": "Anzeigenkiste",
  "version": "0.2.0",
  "description": "Open Source: Anzeigen sichern, neu inserieren und zwischen Kleinanzeigen, Vinted, eBay, willhaben, Facebook, markt.de und Quoka übertragen. Alles lokal, kostenlos.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Anzeigenkiste",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.kleinanzeigen.de/*",
    "https://*.vinted.de/*",
    "https://*.vinted.at/*",
    "https://*.vinted.net/*",
    "https://*.ebay.de/*",
    "https://*.ebay.at/*",
    "https://*.ebayimg.com/*",
    "https://*.willhaben.at/*",
    "https://www.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.markt.de/*",
    "https://*.quoka.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.kleinanzeigen.de/*"
      ],
      "js": [
        "lib/api.js",
        "lib/storage.js",
        "lib/dom.js",
        "lib/selectors.js",
        "lib/parse.js",
        "content/kleinanzeigen.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.de/*",
        "https://www.vinted.at/*",
        "https://www.ebay.de/*",
        "https://www.ebay.at/*",
        "https://www.willhaben.at/*",
        "https://www.facebook.com/marketplace/*",
        "https://www.markt.de/*",
        "https://www.quoka.de/*"
      ],
      "js": [
        "lib/api.js",
        "lib/storage.js",
        "lib/dom.js",
        "lib/platforms.js",
        "lib/parse-product.js",
        "content/export.js",
        "content/import.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  }
}